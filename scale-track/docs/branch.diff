+const mix = (a: number, b: number) => { let h = (a * 0x9e3779b1) ^ (b * 0x85ebca77); h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d); h = Math.imul(h ^ (h >>> 12), 0x297a2d39); return (h ^ (h >>> 15)) >>> 0; };
