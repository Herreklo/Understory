{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": { "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1" },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(gh pr merge * --squash *)",
      "Bash(gh pr merge * --rebase *)",
      "Bash(pkill -f board.sh *)"
    ],
    "ask": [
      "Bash(gh issue comment *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field *)",
      "Bash(gh api * --raw-field *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh release *)",
      "Bash(git push * --delete *)",
      "Bash(git reset --hard *)"
    ],
    "allow": [
      "Bash(npm install)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(./run.sh *)",
      "Bash(.claude/hooks/battery.sh *)",
      "Bash(npx tsx src/tools/*)",
      "Bash(node scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh api repos/Herreklo/Understory/issues/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py battery" }]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py key" }]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py stop" }] }]
  }
}
